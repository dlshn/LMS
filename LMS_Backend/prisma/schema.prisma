generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

model TuitionClass {
  id             String   @id @default(uuid())
  name           String
  joinCode       String   @unique
  isApproved     Boolean  @default(false)
  posterImageKey String?
  posterImageUrl String?
  createdAt      DateTime @default(now())

  admins      Admin[]
  students    Student[]
  attendances Attendance[]
  exams       Exam[]
  notices     Notice[]
  videos      Video[]
  notes       Note[]
}

model Admin {
  id             String        @id @default(uuid())
  tuitionClassId String?
  tuitionClass   TuitionClass? @relation(fields: [tuitionClassId], references: [id])
  name           String
  email          String        @unique
  passwordHash   String
  role           AdminRole     @default(ADMIN)
  createdAt      DateTime      @default(now())
}

model Student {
  id             String       @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass @relation(fields: [tuitionClassId], references: [id])
  studentNumber  String       @unique
  fullName       String
  school         String?
  phone          String?
  parentPhone    String?
  // username/passwordHash are null until the student self-registers with the
  // class join code (see auth.controller#registerStudentSelf). isActivated
  // tracks that explicitly rather than inferring it from username presence.
  username       String?      @unique
  passwordHash   String?
  isActivated    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  attendances Attendance[]
  marks       Mark[]

}

model Attendance {
  id             String           @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass     @relation(fields: [tuitionClassId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  date           DateTime
  status         AttendanceStatus
  createdAt      DateTime         @default(now())

  @@unique([studentId, date])
}

model Exam {
  id             String     @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass @relation(fields: [tuitionClassId], references: [id])
  title          String
  subject        String
  examDate       DateTime
  description    String?
  maxMarks       Int
  status         ExamStatus @default(DRAFT)
  createdAt      DateTime   @default(now())

  marks Mark[]
}

// A short admin-posted announcement, shown to that class's students until
// it expires. No manual cleanup needed — queries just filter on expiresAt.
model Notice {
  id             String       @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass @relation(fields: [tuitionClassId], references: [id])
  message        String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([tuitionClassId, expiresAt])
}

// A recorded class session, linked as an unlisted YouTube URL by the admin.
// Unlisted (not Private) is the only practical option — Private would require
// inviting every student's Google account individually.
model Video {
  id             String       @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass @relation(fields: [tuitionClassId], references: [id])
  title          String
  youtubeUrl     String
  createdAt      DateTime     @default(now())

  @@index([tuitionClassId, createdAt])
}

// An admin-uploaded file (PDF, image, slides) stored in Cloudflare R2.
// fileKey is the R2 object key (used to delete/regenerate a URL later);
// fileUrl is what the browser actually fetches.
model Note {
  id             String       @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass @relation(fields: [tuitionClassId], references: [id])
  title          String
  fileKey        String
  fileUrl        String
  fileType       String
  uploadedAt     DateTime     @default(now())

  @@index([tuitionClassId, uploadedAt])
}

model Mark {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  marksObtained Int
  createdAt     DateTime @default(now())

  @@unique([examId, studentId])
}