{$DOMAIN} {
	encode gzip

	# Same-origin API calls (frontend built with VITE_API_URL pointing at
	# this same domain) get proxied straight to the backend container.
	handle /api/* {
		reverse_proxy backend:5000
	}

	# Everything else is the built SPA. try_files falls back to
	# index.html so client-side routes (e.g. /admin/dashboard) work on a
	# hard refresh instead of 404ing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
