# Copy this to .env (same folder as docker-compose.yml) and fill in real
# values. .env is gitignored — never commit the real one.

# Caddy's site address — a real domain gets it automatic HTTPS.
# Testing on a bare VPS IP with no domain yet? Use ":80" — Caddy then
# serves plain HTTP (no TLS is possible without a domain).
DOMAIN=yourdomain.com

# The full origin people will actually open in a browser — this is what
# gets baked into the frontend and sent to the backend as FRONTEND_URL.
# With a domain:      https://yourdomain.com
# IP-only, no domain: http://203.0.113.10
PUBLIC_URL=https://yourdomain.com

# Self-hosted Postgres (the "postgres" service below)
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=lms

# Same secrets as LMS_Backend/.env used to use — generate long random
# strings for these, don't reuse the dev values.
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string

# Cloudflare R2 (notes file storage) — same values as LMS_Backend/.env
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
